    "recommendation": {
      "local_plasticity": "Support 'local plasticity' with IMMEDIATE INSTALLATION efficacy, not latest-1K at the final checkpoint. Latest-1K at 10K includes edits that have already experienced up to 999 subsequent edits \u2014 not pure plasticity.",
      "three_quantities_to_report": {
        "1_immediate_install": "Efficacy of each batch right after installation (from mechanism logs)",
        "2_latest_100_at_checkpoint": "Latest-100 at each checkpoint (closest to 'still plastic')",
        "3_latest_1K_at_checkpoint": "Latest-1K at each checkpoint (broader cohort measure)"
      },
      "paper_language": "Do NOT say 'latest 1K remains above 90%' at 10K edits. It does not. SAY: 'At 5K edits, the newest cohort retains >99% efficacy while the oldest drops to 70%. At 10K edits, even the newest 1K cohort degrades to 59% (3-seed mean), but the age gradient remains steep \u2014 the oldest cohort falls to 7%.'"
    }
  },
