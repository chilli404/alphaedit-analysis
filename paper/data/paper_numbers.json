  "numerical_reconciliation": {
    "issue": "Paper claims 'latest 1K > 90%' but cross-seed analysis reports 'newest 1K = 59.1%'",
    "resolution": {
      "the_90_percent_claim": "Comes from failure curve at 5K (latest_1K = 99.0%) or matched ordering at 10K (latest_1K = 92.8%). Both are valid but describe different scales.",
      "the_59_percent_number": "Is the 3-seed MEAN of failure curve latest_1K at 10K: seeds 42 (71.9%), 2024 (51.6%), 137 (53.8%). The discrepancy is from averaging across seeds with different degradation levels.",
      "why_matched_ordering_is_higher": "eval_matched_ordering.py uses a DIFFERENT evaluation approach (mega-batch with fp16 model) than the failure curve's vendor evaluate.py. Also uses key_clustered ordering which may interact differently with cache_c. The matched ordering stream has unique-subject records only.",
      "key_confusion": "The paper likely conflates: (1) latest-1K at 5K edits (~99%), (2) latest-1K at 10K edits (59-72% depending on seed), and (3) latest-100 at 10K (80-83%). These are three different quantities."
    },
    "reconciliation_table": {
      "failure_curve_seed42_5K": {
        "latest_1k": 0.99,
        "latest_100": 1.0,
        "first_1k": 0.7,
